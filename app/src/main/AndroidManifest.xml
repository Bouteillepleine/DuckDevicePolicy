<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      A modern (libxposed) module carries NO xposed* meta-data. The framework identifies it
      from META-INF/xposed/ instead: module.prop (min/target API, static scope),
      java_init.list (the entry class) and scope.list (the recommended scope, which replaces
      the old @array/xposed_scope resource). Leaving the legacy meta-data here would not add
      legacy compatibility — the entry-point files decide that — it would only make the module
      advertise an API level it no longer implements. The description the manager shows now
      comes from android:description below.
    -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:description="@string/xposed_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DuckDevicePolicy">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets the LSPosed manager open this screen from the module entry. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
    </application>

</manifest>
